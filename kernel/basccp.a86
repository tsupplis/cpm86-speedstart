;-----------------------------------------------------------------------------
; BASCCP.A86 - SpeedStart BASIC startup command, fixed CCP command-buffer data.
; Apply to the decoded source-built kernel before complementing CODE for disk.
; No instruction or module moves. Maximum command length remains 127; the
; initial ten-character command names MBASIC86.STM through the existing CCP.
;-----------------------------------------------------------------------------
	cseg
	org	0009h
startup_command:
	db	127,10,'A:MBASIC86',0
	end
