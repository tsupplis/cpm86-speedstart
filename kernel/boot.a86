;-----------------------------------------------------------------------------
; BOOT.A86 - SpeedStart CP/M-86 / IBM DR Logo track 0, sector 1.
;
; Original bootstrap loaded by the IBM ROM at physical 0000:7C00h.
; Reads the nonstandard ninth sector of track zero to 0000:7800h and enters it.
; On failure writes the original message directly to MDA/CGA text video memory.
; This is a raw sector, not a CMD program. No DOS boot signature is present.
; Reassembly must match all 512 original bytes, including E5h padding / last zero.
;-----------------------------------------------------------------------------
        cseg
        org     7c00h

;-----------------------------------------------------------------------------
; CODE: ROM entry, extra-sector read and failure display.
;-----------------------------------------------------------------------------
boot:
        mov     es,dx                             ; original ROM-entry convention: DX=0
        mov     bx,7800h
        mov     dx,0                              ; head 0, drive A
        mov     cx,9                              ; track 0, sector ID 9
        mov     ax,0201h                          ; read one 512-byte sector
        int     13h
        jc      read_failed
        jmp     loader_entry
read_failed:
        mov     ax,0040h
        mov     ds,ax
        mov     di,0
        mov     ax,0b000h
        cmp     crt_port,03b4h                    ; BIOS CRT controller port
        jz      video_selected
        mov     ax,0b800h
video_selected:
        mov     es,ax
        mov     si,offset error_message
        cld
        mov     ax,cs
        mov     ds,ax
        mov     cx,38
        mov     ah,07h
write_character:
        lodsb
        stosw
        loop    write_character
halt:
        jmps    halt

;-----------------------------------------------------------------------------
; DATA: boot failure message; remaining sector bytes are padding.
;-----------------------------------------------------------------------------
error_message:
        db      'This is a DR LOGO (TM) data disk only.'
; Unused original sector fill.
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h,0e5h
        db      0e5h
        db      0

;-----------------------------------------------------------------------------
; ADDRESS DECLARATION: second-stage entry; no sector bytes emitted.
;-----------------------------------------------------------------------------
        org     7800h
loader_entry:

;-----------------------------------------------------------------------------
; ADDRESS DECLARATIONS: BIOS data area; no bytes stored in this sector.
;-----------------------------------------------------------------------------
        dseg
        org     0063h
crt_port        rw      1
        end
